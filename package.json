{
  "name": "@runmist/frameworks",
  "version": "2.10.0",
  "publishConfig": {
    "registry": "https://npm.pkg.github.com",
    "access": "public"
  },
  "description": "Framework, ORM, runtime, and monorepo detection for deployment pipelines",
  "files": [
    "dist",
    "LICENSE",
    "README.md"
  ],
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "types": "./dist/index.d.ts",
      "default": "./dist/index.js"
    }
  },
  "scripts": {
    "build": "tsc -p tsconfig.build.json",
    "test": "bun test",
    "test:watch": "bun test --watch",
    "typecheck": "tsc --noEmit",
    "lint": "biome check",
    "lint:fix": "biome check --write",
    "format": "biome format --write",
    "knip": "knip",
    "prepublishOnly": "npm run build && npm test",
    "publish:dev": "npm run build && npm publish --tag dev --access public",
    "publish:patch": "npm version patch && git push --follow-tags",
    "publish:minor": "npm version minor && git push --follow-tags",
    "publish:major": "npm version major && git push --follow-tags"
  },
  "keywords": [
    "framework-detection",
    "orm",
    "monorepo",
    "runtime",
    "deploy",
    "analysis"
  ],
  "repository": {
    "type": "git",
    "url": "git+https://github.com/RunMist/frameworks.git"
  },
  "author": "bitclaw",
  "license": "MIT",
  "devDependencies": {
    "@biomejs/biome": "^2.4.15",
    "knip": "^6.12.1",
    "@types/bun": "^1.3.9",
    "typescript": "^5.8.3"
  },
  "engines": {
    "bun": ">=1.3.0"
  }
}
